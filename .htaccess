# Cache-Konfiguration für JavaScript-Dateien

# data.js: 5 Minuten cache (300 Sekunden)
<FilesMatch "^data\.js$">
  Header set Cache-Control "public, max-age=300, must-revalidate"
  Header set Pragma "public"
  Header set Expires "access plus 5 minutes"
</FilesMatch>

# Alle anderen JS‑Dateien: bis zu 24 Stunden cache, aber mit erzwungener Validierung
<FilesMatch "\.js$">
  Header set Cache-Control "public, max-age=86400, must-revalidate"
  Header set Expires "access plus 24 hours"
</FilesMatch>

# Alle  PNG‑Dateien: bis zu 24 Stunden cache, aber mit erzwungener Validierung
<FilesMatch "\.png$">
  Header set Cache-Control "public, max-age=86400, must-revalidate"
  Header set Expires "access plus 24 hours"
</FilesMatch>

# CSS-Dateien: bis zu 24 Stunden cache
<FilesMatch "\.css$">
  Header set Cache-Control "public, max-age=86400, must-revalidate"
  Header set Expires "access plus 24 hours"
</FilesMatch>

# manifest.json: 1 Stunde cache (ändert sich selten)
<FilesMatch "^manifest\.json$">
  Header set Cache-Control "public, max-age=3600, must-revalidate"
  Header set Expires "access plus 1 hour"
</FilesMatch>

# index.html / HTML: NICHT cachen (wird vom SW precached)
<FilesMatch "\.html?$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# sw.js: NICHT cachen – SW-Updates müssen sofort ankommen!
<FilesMatch "^sw\.js$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>